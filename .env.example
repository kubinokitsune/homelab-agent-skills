# Homelab agent skills library -- configuration template.
#
# Copy this file to ".env" and fill in real values. The .env file is
# gitignored and must NEVER be committed. Add new keys here (with fake or
# placeholder values) as new skills come online, so this stays the single
# source of truth for "what needs configuring".

# -- Qdrant (shared vector memory) -------------------------------------------
# Optional while local; defaults are localhost:6333 if left unset.
QDRANT_HOST=localhost
QDRANT_PORT=6333
# QDRANT_API_KEY=

# -- Ollama (shared embedding + LLM service) ---------------------------------
# Defaults to a local instance. EMBED_MODEL must be pulled: `ollama pull nomic-embed-text`.
OLLAMA_HOST=http://localhost:11434
EMBED_MODEL=nomic-embed-text

# -- Obsidian vault (shared brain) -------------------------------------------
# Absolute path to the vault root on this machine.
OBSIDIAN_VAULT_PATH=C:\Users\pipef\OneDrive\Desktop\AI_Agents\vault

# -- File ops (allowlisted roots) --------------------------------------------
# Directories file_ops may touch, separated by the OS path separator
# (';' on Windows, ':' on Linux). Unset = file_ops refuses to operate.
FILE_OPS_ROOTS=C:\Users\pipef\OneDrive\Desktop\AI_Agents

# -- Web search --------------------------------------------------------------
# Default backend is keyless DuckDuckGo. Leave unset unless switching backends.
# SEARCH_BACKEND=duckduckgo
# SEARCH_API_KEY=        # only for a future paid backend (Brave/SerpAPI)

# -- Pushover (critical alerts that bypass Do Not Disturb) -------------------
PUSHOVER_TOKEN=your_pushover_app_token
PUSHOVER_USER=your_pushover_user_key

# -- Discord (one webhook URL per channel) -----------------------------------
# Logical name "engineering" maps to DISCORD_WEBHOOK_ENGINEERING, etc.
# Add one line per channel you actually post to.
DISCORD_WEBHOOK_ENGINEERING=https://discord.com/api/webhooks/xxx/yyy
DISCORD_WEBHOOK_WARNINGS=https://discord.com/api/webhooks/xxx/yyy
DISCORD_WEBHOOK_CRITICAL=https://discord.com/api/webhooks/xxx/yyy
